<Window x:Class="RestoranTarayici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restoran Tarayıcı" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Kaynaklar" FontWeight="Bold"/>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <CheckBox x:Name="ChkGoogle" Content="Google" IsChecked="True"/>
                    <CheckBox x:Name="ChkTripadvisor" Content="Tripadvisor" IsChecked="True"/>
                    <CheckBox x:Name="ChkZomato" Content="Zomato" IsChecked="True"/>
                    <CheckBox x:Name="ChkFoursquare" Content="Foursquare" IsChecked="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Konum" FontWeight="Bold"/>
                    <TextBlock Text="İl" Margin="0,8,0,2"/>
                    <TextBox x:Name="TxtIl" Height="28"/>
                    <TextBlock Text="İlçe" Margin="0,8,0,2"/>
                    <TextBox x:Name="TxtIlce" Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kategori" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbKategori" SelectedIndex="0" Margin="0,8,0,0" Height="28">
                        <ComboBoxItem Content="Restoran"/>
                        <ComboBoxItem Content="Büfe"/>
                        <ComboBoxItem Content="Kafe"/>
                        <ComboBoxItem Content="Fast Food"/>
                    </ComboBox>
                    <CheckBox x:Name="ChkYorumlar" Content="Yorumları dahil et" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Çıktı" FontWeight="Bold"/>
                    <CheckBox x:Name="ChkJson" Content="JSON" IsChecked="True" Margin="0,8,0,0"/>
                    <CheckBox x:Name="ChkCsv" Content="CSV" IsChecked="True"/>
                    <CheckBox x:Name="ChkXlsx" Content="XLSX" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Padding="8">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnStart" Width="120" Height="36" Content="Başlat" Click="BtnStart_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnStop" Width="120" Height="36" Content="Durdur" Click="BtnStop_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>